# Copy to `.env` on EC2 and fill from your Supabase Cloud project.

# Supabase API settings from Project Settings > API.
SUPABASE_URL=https://srqpkmwqmbyookhahtug.supabase.co/rest/v1/
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# Supabase Postgres settings from Dashboard > Connect.
# EC2 usually works best with the Session pooler unless you enabled IPv6 or the IPv4 add-on.
# Spring Boot needs the JDBC form, not the raw postgres:// form shown by Supabase.
DATABASE_URL=jdbc:postgresql://aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USER=postgres.your-project-ref
DATABASE_PASSWORD=your-database-password
DATABASE_MAX_POOL_SIZE=10
DATABASE_MIN_IDLE=2

# Shared secret required by /internal/** routes via X-Internal-Api-Key.
AUTH_INTERNAL_API_KEY=replace-with-a-long-random-secret
