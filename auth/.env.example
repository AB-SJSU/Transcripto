# Spring auth-api against Supabase Cloud (no local Supabase Docker stack).
#
# Setup:
# 1. Create a project at https://supabase.com/dashboard
# 2. Copy this file to .env and replace every placeholder.
# 3. In Dashboard → Settings → API: Project URL, anon key, service_role key.
# 4. In Dashboard → Settings → Database: copy the connection string or host,
#    port, user, password. Use sslmode=require (Supabase requires TLS).
# 5. Run the SQL in supabase/migrations/*.sql on the cloud database
#    (SQL Editor → New query, or psql against the pool/direct host).
#
# Run locally:
#   export $(grep -v '^#' .env | xargs)   # or use an IDE env loader
#   ./gradlew bootRun
#
# Run in Docker (from this auth/ directory):
#   copy .env.example .env  # then edit .env
#   docker compose --env-file .env up -d --build

# --- Supabase Auth / REST gateway (Dashboard → Settings → API) ---
# Example: https://abcdefghijklmnop.supabase.co (no trailing slash)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# public anon key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# service_role key — server only, never expose to browsers
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Spring JDBC → hosted Postgres (Dashboard → Settings → Database) ---
# Direct connection (IPv6-friendly networks), typical port 5432:
#   jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Session pooler (port 5432), user often postgres.YOUR_PROJECT_REF — see dashboard "Connection string".
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD

# Published port for docker compose
AUTH_API_PORT=8080
