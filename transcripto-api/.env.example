# .env.example
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXX+RoA/8+aJg

S3_AUDIO_BUCKET=transcripto-audio-bucket
S3_TRANSCRIPT_BUCKET=transcripto-transcript-bucket
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/XXXXXXX/transcripto-job-queue
DYNAMODB_TABLE_NAME=TranscriptionJobs

PRESIGNED_URL_EXPIRY_SECONDS=3600

AUTH_SERVICE_URL=http://18.207.238.156:8080
AUTH_INTERNAL_API_KEY=<the key from auth team>

SUPABASE_JWKS_URL=key from auth team


# Comma-separated browser origins allowed to call this API (leave empty until SPA URL is known).
# Example (S3 website endpoint): https://your-bucket.s3-website-us-east-1.amazonaws.com
CORS_ALLOW_ORIGINS=

# Spring auth-api base URL for POST /login and POST /signup proxy (no trailing slash).
# Local auth-api: http://127.0.0.1:8080  |  same Compose network: http://auth-api:8080
# Auth on another EC2/instance: http://<private-ip>:8080 (same VPC) or http://<public-host>:8080
# When auth runs against Supabase Cloud, use the public URL of your deployed auth-api if applicable.
AUTH_SERVICE_BASE_URL=http://127.0.0.1:8080